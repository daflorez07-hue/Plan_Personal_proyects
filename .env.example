# Variables de entorno del Derrotero en Vercel (Settings → Environment Variables).
# Los valores reales los escribes tú en Vercel; nunca en el repositorio.

# Base de datos Postgres. La crea sola la integración de Neon (Storage → Create Database → Neon).
DATABASE_URL=

# Dirección secreta en formato iCal de tu calendario (Google u Outlook). Varias: separadas por coma.
CALENDAR_ICS_URL=
